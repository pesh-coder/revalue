# Explicit local visual review; never enable for public launch.
REVALUE_CONTENT_MODE=review
# Required to use the actual CMS:
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://... # Neon direct URL for migrations; app uses pooled DATABASE_URL.
# DATABASE_TEST_URL=postgresql://.../revalue_test
# PAYLOAD_SECRET=generate-a-long-random-secret

# Enquiry delivery (separate sending-only key in the existing Resend account).
ENQUIRIES_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# Public contact email is edited in CMS > Navigation, footer and contact.
# Set only to a header your deployed reverse proxy overwrites with the real IP.
CONTACT_TRUSTED_IP_HEADER=
# Real public origin, when chosen. Leave blank for local review.
SITE_URL=

# Private S3-compatible storage, such as Cloudflare R2. Empty means local disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Retention is previewed before an Admin explicitly deletes expired records.
ENQUIRY_RETENTION_MONTHS=24
