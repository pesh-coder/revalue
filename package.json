{
  "name": "revalue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "payload generate:importmap && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test": "tsx --test tests/*.test.ts",
    "cms:seed:local": "tsx scripts/seed-local.ts",
    "test:backend": "tsx scripts/verify-backend.ts",
    "db:migrate": "payload migrate",
    "cms:seed:baseline": "tsx scripts/seed-baseline.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-resend": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-type": "21.3.2",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify@<3.4.17": "3.4.17",
      "happy-dom@<21.0.4": "21.0.4",
      "esbuild@<0.25.0": "0.25.12"
    },
    "patchedDependencies": {
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
    }
  }
}
